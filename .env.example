# Copy to .env (never commit .env). Everything here is OPTIONAL.

# --- AI summary (pick one; leave empty for the offline rule-based summary) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# STORE_REPORT_DISABLE_LLM=1

# --- Language: en (default) or id ---
STORE_REPORT_LANG=en

# --- Delivery (disabled unless DELIVERY_ENABLED=true) ---
DELIVERY_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
