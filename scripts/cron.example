# Linux cron example: build and send the report every day at 06:00 server time.
# Edit with `crontab -e`. Keep secrets in .env (chmod 600), never in this file.
0 6 * * * cd /opt/daily-store-report && set -a && . ./.env && set +a && .venv/bin/python -m store_report report --input /data/export/daily_store_sales.xlsx --out output --send >> logs/report.log 2>&1
